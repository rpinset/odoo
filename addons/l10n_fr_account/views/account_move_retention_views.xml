<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_fr_retention" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.fr.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group name="l10n_fr_retention_guarantee_group"
                       string="Retention Guarantee"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="l10n_fr_has_retention_guarantee" readonly="state != 'draft'"/>
                    <field name="l10n_fr_retention_clause_note"
                           invisible="not l10n_fr_has_retention_guarantee"
                           required="l10n_fr_has_retention_guarantee"
                           readonly="state != 'draft'"
                           placeholder="Retenue de garantie de 5 % (loi n°71-584 du 16 juillet 1971). Libérable un an après réception des travaux."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
