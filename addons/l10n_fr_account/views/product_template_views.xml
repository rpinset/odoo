<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_only_form_view_deee" model="ir.ui.view">
        <field name="name">product.template.form.deee.fr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group name="l10n_fr_deee_group" string="Eco-Participation (DEEE)"
                       invisible="not sale_ok or type == 'combo'">
                    <field name="l10n_fr_deee_category"/>
                    <field name="l10n_fr_deee_amount" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
